{
  "name": "rtl-for-claude",
  "displayName": "RTL for Claude",
  "description": "Right-to-left text + the Vazirmatn font in the Claude Code chat — and, if you opt in, the Codex chat too. For Persian, Arabic, Urdu and every RTL language. Auto-applies and survives updates.",
  "version": "1.4.3",
  "publisher": "mahdigh99",
  "author": "Mahdi Ghorbanian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mahdigh99/rtl-for-claude.git"
  },
  "homepage": "https://github.com/mahdigh99/rtl-for-claude#readme",
  "bugs": {
    "url": "https://github.com/mahdigh99/rtl-for-claude/issues"
  },
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "rtl",
    "right-to-left",
    "bidi",
    "bidirectional",
    "direction",
    "persian",
    "farsi",
    "arabic",
    "urdu",
    "hebrew",
    "kurdish",
    "pashto",
    "sindhi",
    "uyghur",
    "dhivehi",
    "claude",
    "claude code",
    "anthropic",
    "codex",
    "openai",
    "vazirmatn",
    "font",
    "typography",
    "chat",
    "webview",
    "localization",
    "i18n",
    "l10n",
    "iran",
    "middle east",
    "markdown preview"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:uninstall": "node ./uninstall.js"
  },
  "contributes": {
    "markdown.previewStyles": [
      "./media/markdown-rtl.css"
    ],
    "markdown.previewScripts": [
      "./media/markdown-rtl.js"
    ],
    "commands": [
      {
        "command": "rtlForClaude.toggle",
        "title": "%cmd.toggle%",
        "category": "%cmd.category%"
      },
      {
        "command": "rtlForClaude.toggleSidebar",
        "title": "%cmd.toggleSidebar%",
        "category": "%cmd.category%"
      },
      {
        "command": "rtlForClaude.apply",
        "title": "%cmd.apply%",
        "category": "%cmd.category%"
      },
      {
        "command": "rtlForClaude.remove",
        "title": "%cmd.remove%",
        "category": "%cmd.category%"
      },
      {
        "command": "rtlForClaude.openSettings",
        "title": "%cmd.openSettings%",
        "category": "%cmd.category%"
      }
    ],
    "keybindings": [
      {
        "command": "rtlForClaude.toggle",
        "key": "ctrl+shift+8",
        "mac": "cmd+shift+8"
      },
      {
        "command": "rtlForClaude.apply",
        "key": "ctrl+shift+7",
        "mac": "cmd+shift+7"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rtlForClaude",
          "title": "%view.title%",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "views": {
      "rtlForClaude": [
        {
          "type": "webview",
          "id": "rtlForClaude.panel",
          "name": "%view.title%",
          "when": "config.rtlForClaude.showInActivityBar"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "rtlForClaude.enabled": {
          "type": "boolean",
          "default": true,
          "order": 0,
          "markdownDescription": "%config.enabled%"
        },
        "rtlForClaude.autoApplyOnStartup": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "markdownDescription": "%config.autoApplyOnStartup%"
        },
        "rtlForClaude.showInActivityBar": {
          "type": "boolean",
          "default": true,
          "order": 10,
          "description": "%config.showInActivityBar%"
        },
        "rtlForClaude.showStatusBar": {
          "type": "boolean",
          "default": true,
          "order": 11,
          "description": "%config.showStatusBar%"
        },
        "rtlForClaude.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "fa",
            "ar",
            "ur"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "فارسی (Persian)",
            "العربية (Arabic)",
            "اردو (Urdu)"
          ],
          "default": "auto",
          "order": 1.5,
          "description": "%config.language%"
        },
        "rtlForClaude.font.family": {
          "type": "string",
          "enum": [
            "Vazirmatn",
            "Sahel",
            "System default",
            "Custom"
          ],
          "default": "Vazirmatn",
          "order": 2,
          "description": "%config.font.family%"
        },
        "rtlForClaude.font.custom": {
          "type": "string",
          "default": "",
          "order": 2.5,
          "markdownDescription": "%config.font.custom%"
        },
        "rtlForClaude.font.scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.8,
          "maximum": 1.6,
          "order": 3,
          "description": "%config.font.scale%"
        },
        "rtlForClaude.font.lineHeight": {
          "type": "number",
          "default": 1.85,
          "minimum": 1.3,
          "maximum": 2.5,
          "order": 4,
          "description": "%config.font.lineHeight%"
        },
        "rtlForClaude.font.letterSpacing": {
          "type": "number",
          "default": 0,
          "minimum": -0.05,
          "maximum": 0.2,
          "order": 4.5,
          "markdownDescription": "%config.font.letterSpacing%"
        },
        "rtlForClaude.detection.mode": {
          "type": "string",
          "enum": [
            "ratio",
            "first-strong"
          ],
          "enumDescriptions": [
            "%config.detection.mode.ratio%",
            "%config.detection.mode.firstStrong%"
          ],
          "default": "ratio",
          "order": 5,
          "description": "%config.detection.mode%"
        },
        "rtlForClaude.detection.threshold": {
          "type": "number",
          "default": 0.1,
          "minimum": 0.1,
          "maximum": 0.7,
          "order": 6,
          "markdownDescription": "%config.detection.threshold%"
        },
        "rtlForClaude.applyToInput": {
          "type": "boolean",
          "default": true,
          "order": 7,
          "description": "%config.applyToInput%"
        },
        "rtlForClaude.showMessageToggles": {
          "type": "boolean",
          "default": true,
          "order": 8,
          "description": "%config.showMessageToggles%"
        },
        "rtlForClaude.keepCodeLeftToRight": {
          "type": "boolean",
          "default": true,
          "order": 9,
          "description": "%config.keepCodeLeftToRight%"
        },
        "rtlForClaude.codex.enabled": {
          "type": "boolean",
          "default": false,
          "order": 9.5,
          "markdownDescription": "%config.codex.enabled%"
        },
        "rtlForClaude.togglePlacement": {
          "type": "string",
          "enum": [
            "toolbar",
            "floating",
            "hidden"
          ],
          "enumDescriptions": [
            "%config.togglePlacement.toolbar%",
            "%config.togglePlacement.floating%",
            "%config.togglePlacement.hidden%"
          ],
          "default": "toolbar",
          "order": 10,
          "description": "%config.togglePlacement%"
        }
      }
    }
  }
}
